{
  "manifest_version": 3,
  "name": "Context Search Assistant",
  "version": "1.0",
  "description": "Inline search and note-taking for focused workflow",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://openrouter.ai/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
